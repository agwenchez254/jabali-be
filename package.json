{
  "name": "jabali-be",
  "version": "0.1.0",
  "private": true,
  "description": "Jabali storefront + admin API (NestJS, Prisma, PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "jest --runInBand",
    "mail:sample": "tsx scripts/send-sample-mails.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "9.3.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.11.3",
    "nodemailer": "^10.1.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.33.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^29.5.14",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "mailparser": "^3.9.39",
    "prisma": "^6.19.3",
    "smtp-server": "^3.19.22",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "overrides": {
    "js-yaml": "5.4.3",
    "deepmerge-ts": "8.0.2"
  }
}
