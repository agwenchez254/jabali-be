NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose maps container 5432 -> host 5439)
DATABASE_URL=postgresql://jabali:jabali_dev_pw@localhost:5439/jabali?schema=public
# Used by e2e tests only (database is created automatically)
TEST_DATABASE_URL=postgresql://jabali:jabali_dev_pw@localhost:5439/jabali_test?schema=public

# Comma separated CORS allow-list (storefront, dashboard)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT. DEV-ONLY secrets: generate real ones for any shared environment
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Uploads (local disk, served at /uploads)
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000
MAX_UPLOAD_MB=5

# Seed owner account (admin@jabali.co.ke).
# DEV-ONLY default below. If SEED_ADMIN_PASSWORD is unset, the seed generates a random
# password and prints it once.
SEED_ADMIN_PASSWORD=ChangeMe-Dev-Only-123!

# M-Pesa Daraja (STK push). Leave blank to use the mock provider; payments then stay "pending"
# until staff confirm them. Get credentials from https://developer.safaricom.co.ke (Daraja app).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Secret path segment protecting the callback (>= 16 chars), e.g. `openssl rand -hex 24`
MPESA_CALLBACK_SECRET=
# Public HTTPS URL Safaricom posts results to: https://<public-api>/api/v1/webhooks/mpesa/<MPESA_CALLBACK_SECRET>
# (use a tunnel such as ngrok in development)
MPESA_CALLBACK_URL=

# In-process schedulers (order reservation expiry, scheduled content publishing). Set false in tests.
ENABLE_SCHEDULER=true

# Request signing. Our frontends sign every mutation and every personal or staff read with HMAC-SHA256.
# Format: client:key,client:key. Keys must be 32+ characters in production; generate with `openssl rand -base64 48`.
# The same key goes into each frontend build as VITE_SIGNING_KEY. REQUEST_SIGNING=off is refused in production.
# Without keys, development uses built-in dev keys.
# REQUEST_SIGNING=on
# REQUEST_SIGNING_KEYS=storefront:CHANGE_ME_32_CHARS_MINIMUM,dashboard:CHANGE_ME_32_CHARS_MINIMUM
