generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums
enum Gender {
  men
  women
}

enum ProductStatus {
  draft
  active
  archived
}

enum MovementReason {
  sale
  restock
  adjustment
  return
}

enum PromotionType {
  percent
  fixed
  free_delivery
  bogo
}

enum PromotionStatus {
  draft
  active
  paused
}

enum PromotionTargetType {
  all
  category
  product
}

enum OrderStatus {
  pending
  paid
  packed
  shipped
  delivered
  cancelled
  refunded
}

enum FulfilmentMethod {
  delivery
  pickup
}

enum PaymentProvider {
  mpesa
  airtel
  card
  cod
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum ContentKind {
  hero
  banner
  testimonial_set
  category_tiles
  rich_text
  faq
  gift_promo
}

enum PublishStatus {
  draft
  published
}

enum StaffStatus {
  active
  disabled
}

// ---------------------------------------------------------------- media
model Media {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  url        String
  mime       String
  width      Int?
  height     Int?
  bytes      Int      @default(0)
  alt        String   @default("")
  uploadedBy String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categories    Category[]
  productImages ProductImage[]
  testimonials  Testimonial[]

  @@map("media")
}

// ---------------------------------------------------------------- catalogue
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  gender    Gender
  slug      String
  label     String
  tagline   String   @default("")
  imageId   String?  @db.Uuid
  sortOrder Int      @default(0)
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image    Media?     @relation(fields: [imageId], references: [id], onDelete: SetNull)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([gender, slug])
  @@map("categories")
}

model Colour {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  hex       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productColours ProductColour[]
  images         ProductImage[]
  variants       Variant[]

  @@map("colours")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  name           String
  gender         Gender
  categoryId     String        @db.Uuid
  blurb          String        @default("")
  basePrice      Int
  compareAtPrice Int?
  status         ProductStatus @default(draft)
  isNew          Boolean       @default(false)
  isBestseller   Boolean       @default(false)
  ratingAvg      Float         @default(0)
  soldCount      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  category Category        @relation(fields: [categoryId], references: [id])
  colours  ProductColour[]
  images   ProductImage[]
  variants Variant[]

  @@index([status, categoryId, gender])
  @@index([deletedAt])
  @@map("products")
}

model ProductColour {
  productId String @db.Uuid
  colourId  String @db.Uuid
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colour  Colour  @relation(fields: [colourId], references: [id])

  @@id([productId, colourId])
  @@map("product_colours")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  colourId  String?  @db.Uuid // null = shared gallery
  mediaId   String   @db.Uuid
  position  Int      @default(0)
  alt       String   @default("")
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colour  Colour? @relation(fields: [colourId], references: [id], onDelete: SetNull)
  media   Media   @relation(fields: [mediaId], references: [id])

  @@index([productId, colourId, position])
  @@map("product_images")
}

model Variant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  colourId      String   @db.Uuid
  size          String
  sku           String   @unique
  priceOverride Int?
  barcode       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  colour     Colour              @relation(fields: [colourId], references: [id])
  inventory  Inventory?
  movements  InventoryMovement[]
  orderLines OrderLine[]

  @@unique([productId, colourId, size])
  @@map("variants")
}

model Inventory {
  variantId         String   @id @db.Uuid
  onHand            Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(3)
  updatedAt         DateTime @updatedAt

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model InventoryMovement {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @db.Uuid
  delta     Int
  reason    MovementReason
  ref       String?
  note      String?
  actorId   String?        @db.Uuid
  createdAt DateTime       @default(now())

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------- promotions
model Promotion {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  code             String?         @unique
  type             PromotionType
  value            Int             @default(0)
  status           PromotionStatus @default(draft)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int             @default(0)
  minSubtotal      Int             @default(0)
  stackable        Boolean         @default(false)
  priority         Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  targets     PromotionTarget[]
  redemptions PromotionRedemption[]

  @@index([status, startsAt, endsAt])
  @@map("promotions")
}

model PromotionTarget {
  id          String              @id @default(uuid()) @db.Uuid
  promotionId String              @db.Uuid
  targetType  PromotionTargetType
  targetId    String?             @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@map("promotion_targets")
}

model PromotionRedemption {
  id          String   @id @default(uuid()) @db.Uuid
  promotionId String   @db.Uuid
  orderId     String   @db.Uuid
  customerRef String
  amount      Int
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([promotionId, customerRef])
  @@map("promotion_redemptions")
}

// ---------------------------------------------------------------- orders
model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders  Order[]
  account CustomerAccount?

  @@map("customers")
}

model Order {
  id                   String           @id @default(uuid()) @db.Uuid
  seq                  Int              @unique @default(autoincrement())
  number               String?          @unique
  customerId           String           @db.Uuid
  status               OrderStatus      @default(pending)
  method               FulfilmentMethod
  subtotal             Int
  discount             Int              @default(0)
  deliveryFee          Int              @default(0)
  total                Int
  paymentMethod        PaymentProvider
  county               String?
  address              String?
  eta                  String?
  notes                String?
  idempotencyKey       String           @unique
  stockCommitted       Boolean          @default(false)
  reservationExpiresAt DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  customer    Customer              @relation(fields: [customerId], references: [id])
  lines       OrderLine[]
  payments    Payment[]
  events      OrderEvent[]
  redemptions PromotionRedemption[]

  @@index([status, createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderLine {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @db.Uuid
  variantId      String @db.Uuid
  productId      String @db.Uuid
  nameSnapshot   String
  colourSnapshot String
  skuSnapshot    String
  size           String
  unitPrice      Int
  qty            Int
  discountAmount Int    @default(0)
  gift           Json?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_lines")
}

model Payment {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @db.Uuid
  provider    PaymentProvider
  status      PaymentStatus   @default(pending)
  amount      Int
  providerRef String?
  raw         Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  type      String
  actorId   String?  @db.Uuid
  note      String?
  data      Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ---------------------------------------------------------------- delivery
model DeliveryZone {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  counties  String[]
  fee       Int
  etaDays   Int      @default(2)
  eta       String   @default("")
  freeOver  Int?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("delivery_zones")
}

// ---------------------------------------------------------------- content
model ContentBlock {
  id          String        @id @default(uuid()) @db.Uuid
  key         String        @unique
  kind        ContentKind
  gender      Gender?
  data        Json          @default("{}") // live content
  draftData   Json? // pending draft (null when none)
  status      PublishStatus @default(draft)
  publishAt   DateTime?
  unpublishAt DateTime?
  version     Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  versions ContentBlockVersion[]

  @@index([kind, gender, status])
  @@map("content_blocks")
}

model ContentBlockVersion {
  id        String   @id @default(uuid()) @db.Uuid
  blockId   String   @db.Uuid
  version   Int
  data      Json
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  block ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, version])
  @@map("content_block_versions")
}

model Testimonial {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  location      String   @default("")
  quote         String
  avatarMediaId String?  @db.Uuid
  rating        Int      @default(5)
  gender        Gender? // null = shown for both
  isLead        Boolean  @default(false)
  isPublished   Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  avatar Media? @relation(fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@map("testimonials")
}

model Page {
  id        String        @id @default(uuid()) @db.Uuid
  slug      String        @unique
  title     String
  blocks    Json          @default("[]")
  status    PublishStatus @default(draft)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("pages")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ---------------------------------------------------------------- access
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  staff       StaffUser[]

  @@map("roles")
}

model RolePermission {
  roleId     String @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model StaffUser {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  email        String      @unique
  passwordHash String
  roleId       String      @db.Uuid
  status       StaffStatus @default(active)
  lastLoginAt  DateTime?
  failedLogins Int         @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]

  @@map("staff_users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  staffId      String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([staffId])
  @@map("refresh_tokens")
}

model AuditLog {
  id       String   @id @default(uuid()) @db.Uuid
  actorId  String?  @db.Uuid
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  ip       String?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
  @@map("audit_log")
}

enum AccountStatus {
  active
  disabled
}

model CustomerAccount {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String        @unique @db.Uuid
  email        String        @unique
  passwordHash String
  /** The name the account holder gave. Kept separate from Customer.name so a linked guest record is never exposed or edited. */
  displayName  String        @default("")
  status       AccountStatus @default(active)
  failedLogins Int           @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Email verification (null emailVerifiedAt = pending). Only a keyed hash of the code is stored.
  emailVerifiedAt     DateTime?
  verifyCodeHash      String?
  verifyExpiresAt     DateTime?
  verifyAttempts      Int       @default(0)
  verifySentAt        DateTime?
  verifySendsThisHour Int       @default(0)
  verifyWindowStart   DateTime?

  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refreshTokens CustomerRefreshToken[]

  @@map("customer_accounts")
}

model CustomerRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([accountId])
  @@map("customer_refresh_tokens")
}
